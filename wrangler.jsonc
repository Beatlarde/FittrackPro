/**
 * FitTrack Pro — un solo Worker:
 *   /api/*  → backend (worker/index.js)
 *   resto   → frontend React compilado en ./dist
 * Build: npm run build  →  Deploy: npx wrangler deploy
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fittrackpro-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Un solo Cron Trigger cada 15 min; worker/crons.js decide qué tarea toca según la hora de CDMX
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Dominio propio (zona en Cloudflare desde 2026-11-04). Wrangler crea los registros DNS y el certificado.
  // www → raíz se hace con una Redirect Rule en el panel de Cloudflare (corre antes del Worker).
  "routes": [
    { "pattern": "fittrackpro.store", "custom_domain": true },
    { "pattern": "www.fittrackpro.store", "custom_domain": true }
  ],
  "vars": {
    "FRONTEND_URL": "https://fittrackpro.store"
  }
}
